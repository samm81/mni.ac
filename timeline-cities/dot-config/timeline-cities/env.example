# paths passed to timeline_cities.py
TIMELINE_GPX_DIRECTORY=/path/to/timeline-data/input/gpx
TIMELINE_OUTPUT=/path/to/timeline-data/publish/timeline

# optional inputs; uncomment only when needed
# TIMELINE_GOOGLE_TIMELINE=/path/to/google/location-history.json
# TIMELINE_OVERRIDES_DIRECTORY=/path/to/timeline-data/config/overrides

# processing options; uncomment and edit to override application defaults
# TIMELINE_MAJOR_POPULATION=500000
# TIMELINE_MAJOR_RADIUS_KM=75
# TIMELINE_REGIONAL_POPULATION=100000
# TIMELINE_REGIONAL_RADIUS_KM=40
# TIMELINE_MAX_ACCURACY_M=50000
# TIMELINE_MAX_GAP_HOURS=3
# TIMELINE_CLUSTER_RADIUS_M=500
# TIMELINE_CLUSTER_GAP_MINUTES=60
