[Unit]
Description=refresh the timeline cities ledger
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/opt/apps/timeline-cities
EnvironmentFile=%h/.config/timeline-cities/.env
ExecStart=%h/opt/scripts/refresh-timeline.bash %h/opt/apps/timeline-cities
TimeoutStartSec=0
